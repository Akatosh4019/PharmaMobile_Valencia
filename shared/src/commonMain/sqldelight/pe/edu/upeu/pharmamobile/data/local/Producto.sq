CREATE TABLE producto (
  id INTEGER NOT NULL PRIMARY KEY,
  nombre TEXT NOT NULL,
  precio REAL NOT NULL,
  stock INTEGER NOT NULL,
  activo INTEGER NOT NULL,
  categoria_id INTEGER,
  categoria_nombre TEXT,
  pendiente INTEGER NOT NULL DEFAULT 0,
  intentos INTEGER NOT NULL DEFAULT 0,
  ultimo_error TEXT
);

CREATE TABLE categoria (
  id INTEGER NOT NULL PRIMARY KEY,
  nombre TEXT NOT NULL
);

CREATE TABLE sincronizacion (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  instante_millis INTEGER NOT NULL
);

listarTodos:
SELECT * FROM producto ORDER BY nombre;

buscarPorId:
SELECT * FROM producto WHERE id = ?;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1 AND intentos < ? ORDER BY id;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos < ?;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos >= ?;

listarFallidas:
SELECT id, nombre, intentos, ultimo_error FROM producto
WHERE pendiente = 1 AND intentos >= ? ORDER BY id;

idTemporalSiguiente:
SELECT COALESCE(MIN(id), 0) - 1 FROM producto WHERE id < 0;

guardarProducto:
INSERT OR REPLACE INTO producto(id, nombre, precio, stock, activo, categoria_id, categoria_nombre, pendiente, intentos, ultimo_error)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimo_error = ? WHERE id = ?;

marcarFallida:
UPDATE producto SET intentos = ?, ultimo_error = ? WHERE id = ?;

intentosPorId:
SELECT intentos FROM producto WHERE id = ?;

eliminarProducto:
DELETE FROM producto WHERE id = ?;

eliminarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

listarCategorias:
SELECT * FROM categoria ORDER BY nombre;

guardarCategoria:
INSERT OR REPLACE INTO categoria(id, nombre) VALUES (?, ?);

ultimaSincronizacion:
SELECT instante_millis FROM sincronizacion WHERE id = 1;

guardarSincronizacion:
INSERT OR REPLACE INTO sincronizacion(id, instante_millis) VALUES (1, ?);
